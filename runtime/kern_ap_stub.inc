// kern_ap_stub for runtime/kernel.c (asynchronous preemption), one per host ABI. A file of its own so that
// tests/platform_check.c runs the same stub against an interrupted register-checking loop.
// Included by kernel.c and tests/platform_check.c; it defines the global kern_ap_stub and calls kern_ap_rip and
// kern_ap_yield, which the includer provides.

// kern_ap_stub: entered in place of the interrupted instruction of top-level game code. It keeps every register the
// game code may have live (volatile GPRs, flags, YMM0-15, MXCSR; the C calls preserve the rest), gives the core up
// in kern_ap_yield and jumps back to kern_ap_rip(), whose value it first stores in the return slot it reserved at
// entry, so a stack walk sees the interrupted function as its caller. No ret: the jump keeps call/return pairs
// balanced. The waiter never writes the owner's stack.
#if defined(__x86_64__)
// An x86-64-v2 build (no __AVX__) saves XMM0-15 with SSE moves into the same 32-byte slots instead: its game code
// keeps nothing in the upper YMM halves, and the CPUs it is for have no VEX encoding, so a vmovdqa there faults with
// an illegal instruction the first time a core is interrupted.
#ifdef __AVX__
#define AP_VMOV "vmovdqa"
#define AP_V "%ymm"
#define AP_VZEROUPPER "    vzeroupper\n"
#else
#define AP_VMOV "movdqa"
#define AP_V "%xmm"
#define AP_VZEROUPPER ""
#endif
#endif
#ifdef _WIN32
__asm__(".text\n"
        ".globl kern_ap_stub\n"
        ".def kern_ap_stub; .scl 2; .type 32; .endef\n"
        ".p2align 4\n"
        "kern_ap_stub:\n"
        ".seh_proc kern_ap_stub\n"
        "    leaq -8(%rsp), %rsp\n"   // not sub: the flags are still the interrupted code's until pushfq
        ".seh_stackalloc 8\n"
        "    pushfq\n"
        ".seh_stackalloc 8\n"
        "    pushq %rax\n"
        ".seh_pushreg %rax\n"
        "    pushq %rcx\n"
        ".seh_pushreg %rcx\n"
        "    pushq %rdx\n"
        ".seh_pushreg %rdx\n"
        "    pushq %r8\n"
        ".seh_pushreg %r8\n"
        "    pushq %r9\n"
        ".seh_pushreg %r9\n"
        "    pushq %r10\n"
        ".seh_pushreg %r10\n"
        "    pushq %r11\n"
        ".seh_pushreg %r11\n"
        "    pushq %rbp\n"
        ".seh_pushreg %rbp\n"
        "    movq %rsp, %rbp\n"
        ".seh_setframe %rbp, 0\n"
        ".seh_endprologue\n"
        "    andq $-32, %rsp\n"
        "    subq $576, %rsp\n"   // 0: shadow space, 32: MXCSR saved, 36: MXCSR default, 64: YMM0-15 (XMM0-15 without AVX)
        "    " AP_VMOV " " AP_V "0, 64(%rsp)\n"
        "    " AP_VMOV " " AP_V "1, 96(%rsp)\n"
        "    " AP_VMOV " " AP_V "2, 128(%rsp)\n"
        "    " AP_VMOV " " AP_V "3, 160(%rsp)\n"
        "    " AP_VMOV " " AP_V "4, 192(%rsp)\n"
        "    " AP_VMOV " " AP_V "5, 224(%rsp)\n"
        "    " AP_VMOV " " AP_V "6, 256(%rsp)\n"
        "    " AP_VMOV " " AP_V "7, 288(%rsp)\n"
        "    " AP_VMOV " " AP_V "8, 320(%rsp)\n"
        "    " AP_VMOV " " AP_V "9, 352(%rsp)\n"
        "    " AP_VMOV " " AP_V "10, 384(%rsp)\n"
        "    " AP_VMOV " " AP_V "11, 416(%rsp)\n"
        "    " AP_VMOV " " AP_V "12, 448(%rsp)\n"
        "    " AP_VMOV " " AP_V "13, 480(%rsp)\n"
        "    " AP_VMOV " " AP_V "14, 512(%rsp)\n"
        "    " AP_VMOV " " AP_V "15, 544(%rsp)\n"
        "    stmxcsr 32(%rsp)\n"
        "    movl $0x1f80, 36(%rsp)\n"
        "    ldmxcsr 36(%rsp)\n"
        "    cld\n"
        AP_VZEROUPPER
        "    call kern_ap_rip\n"
        "    movq %rax, 72(%rbp)\n"   // the return slot: rbp + 8 pushes + pushfq
        "    call kern_ap_yield\n"
        "    ldmxcsr 32(%rsp)\n"
        "    " AP_VMOV " 64(%rsp), " AP_V "0\n"
        "    " AP_VMOV " 96(%rsp), " AP_V "1\n"
        "    " AP_VMOV " 128(%rsp), " AP_V "2\n"
        "    " AP_VMOV " 160(%rsp), " AP_V "3\n"
        "    " AP_VMOV " 192(%rsp), " AP_V "4\n"
        "    " AP_VMOV " 224(%rsp), " AP_V "5\n"
        "    " AP_VMOV " 256(%rsp), " AP_V "6\n"
        "    " AP_VMOV " 288(%rsp), " AP_V "7\n"
        "    " AP_VMOV " 320(%rsp), " AP_V "8\n"
        "    " AP_VMOV " 352(%rsp), " AP_V "9\n"
        "    " AP_VMOV " 384(%rsp), " AP_V "10\n"
        "    " AP_VMOV " 416(%rsp), " AP_V "11\n"
        "    " AP_VMOV " 448(%rsp), " AP_V "12\n"
        "    " AP_VMOV " 480(%rsp), " AP_V "13\n"
        "    " AP_VMOV " 512(%rsp), " AP_V "14\n"
        "    " AP_VMOV " 544(%rsp), " AP_V "15\n"
        "    movq %rbp, %rsp\n"
        "    popq %rbp\n"
        "    popq %r11\n"
        "    popq %r10\n"
        "    popq %r9\n"
        "    popq %r8\n"
        "    popq %rdx\n"
        "    popq %rcx\n"
        "    popq %rax\n"
        "    popfq\n"
        "    leaq 8(%rsp), %rsp\n"
        "    jmpq *-8(%rsp)\n"
        ".seh_endproc\n");
#elif defined(__x86_64__)
// The System V version: rsi and rdi are volatile there too, and the interrupted code may keep data in the 128 bytes
// below its stack pointer (the red zone), so the return slot and the saves go below that. Without a red zone in the
// way the slot is at entry - 136; the exit restores rsp to the entry value and jumps through the slot.
__asm__(".text\n"
        ".globl kern_ap_stub\n"
        ".type kern_ap_stub, @function\n"
        ".p2align 4\n"
        "kern_ap_stub:\n"
        "    .cfi_startproc\n"
        "    leaq -136(%rsp), %rsp\n"   // not sub: the flags are still the interrupted code's until pushfq
        "    pushfq\n"
        "    pushq %rax\n"
        "    pushq %rcx\n"
        "    pushq %rdx\n"
        "    pushq %rsi\n"
        "    pushq %rdi\n"
        "    pushq %r8\n"
        "    pushq %r9\n"
        "    pushq %r10\n"
        "    pushq %r11\n"
        "    pushq %rbp\n"
        "    movq %rsp, %rbp\n"
        "    andq $-32, %rsp\n"
        "    subq $576, %rsp\n"   // 32: MXCSR saved, 36: MXCSR default, 64: YMM0-15 (XMM0-15 without AVX)
        "    " AP_VMOV " " AP_V "0, 64(%rsp)\n"
        "    " AP_VMOV " " AP_V "1, 96(%rsp)\n"
        "    " AP_VMOV " " AP_V "2, 128(%rsp)\n"
        "    " AP_VMOV " " AP_V "3, 160(%rsp)\n"
        "    " AP_VMOV " " AP_V "4, 192(%rsp)\n"
        "    " AP_VMOV " " AP_V "5, 224(%rsp)\n"
        "    " AP_VMOV " " AP_V "6, 256(%rsp)\n"
        "    " AP_VMOV " " AP_V "7, 288(%rsp)\n"
        "    " AP_VMOV " " AP_V "8, 320(%rsp)\n"
        "    " AP_VMOV " " AP_V "9, 352(%rsp)\n"
        "    " AP_VMOV " " AP_V "10, 384(%rsp)\n"
        "    " AP_VMOV " " AP_V "11, 416(%rsp)\n"
        "    " AP_VMOV " " AP_V "12, 448(%rsp)\n"
        "    " AP_VMOV " " AP_V "13, 480(%rsp)\n"
        "    " AP_VMOV " " AP_V "14, 512(%rsp)\n"
        "    " AP_VMOV " " AP_V "15, 544(%rsp)\n"
        "    stmxcsr 32(%rsp)\n"
        "    movl $0x1f80, 36(%rsp)\n"
        "    ldmxcsr 36(%rsp)\n"
        "    cld\n"
        AP_VZEROUPPER
        "    call kern_ap_rip\n"
        "    movq %rax, 88(%rbp)\n"   // the return slot: rbp + 10 pushes + pushfq
        "    call kern_ap_yield\n"
        "    ldmxcsr 32(%rsp)\n"
        "    " AP_VMOV " 64(%rsp), " AP_V "0\n"
        "    " AP_VMOV " 96(%rsp), " AP_V "1\n"
        "    " AP_VMOV " 128(%rsp), " AP_V "2\n"
        "    " AP_VMOV " 160(%rsp), " AP_V "3\n"
        "    " AP_VMOV " 192(%rsp), " AP_V "4\n"
        "    " AP_VMOV " 224(%rsp), " AP_V "5\n"
        "    " AP_VMOV " 256(%rsp), " AP_V "6\n"
        "    " AP_VMOV " 288(%rsp), " AP_V "7\n"
        "    " AP_VMOV " 320(%rsp), " AP_V "8\n"
        "    " AP_VMOV " 352(%rsp), " AP_V "9\n"
        "    " AP_VMOV " 384(%rsp), " AP_V "10\n"
        "    " AP_VMOV " 416(%rsp), " AP_V "11\n"
        "    " AP_VMOV " 448(%rsp), " AP_V "12\n"
        "    " AP_VMOV " 480(%rsp), " AP_V "13\n"
        "    " AP_VMOV " 512(%rsp), " AP_V "14\n"
        "    " AP_VMOV " 544(%rsp), " AP_V "15\n"
        "    movq %rbp, %rsp\n"
        "    popq %rbp\n"
        "    popq %r11\n"
        "    popq %r10\n"
        "    popq %r9\n"
        "    popq %r8\n"
        "    popq %rdi\n"
        "    popq %rsi\n"
        "    popq %rdx\n"
        "    popq %rcx\n"
        "    popq %rax\n"
        "    popfq\n"
        "    leaq 136(%rsp), %rsp\n"
        "    jmpq *-136(%rsp)\n"
        "    .cfi_endproc\n"
        ".size kern_ap_stub, .-kern_ap_stub\n");
#elif defined(__aarch64__)
// The AArch64 version. A branch needs a register, and the interrupted code may have any of x0-x30 live, so the
// generated code is compiled without x18 (tools/build_game.py GEN_ARCH_FLAGS, -ffixed-x18; Linux leaves x18 to
// programs) and the stub jumps back through it. It saves x0-x17, x29, x30, NZCV, FPCR, FPSR and all of q0-q31
// (AAPCS64 keeps only the low halves of v8-v15 across calls) in a 720-byte frame: x0-x17 at 0, x29 and x30 at 144,
// NZCV, FPCR and FPSR at 160, q0-q31 at 192, and at 704 a frame record of the interrupted x29 and pc, which x29 points
// to during the calls, so a stack walk sees the interrupted function as the caller. AAPCS64 has no red zone and sp
// stays 16-byte aligned at every instruction, so the frame goes right below the interrupted sp. kern_ap_yield runs C
// code with the default FPCR (as the x86 versions load the default MXCSR).
__asm__(".text\n"
        ".globl kern_ap_stub\n"
        ".type kern_ap_stub, %function\n"
        ".p2align 4\n"
        "kern_ap_stub:\n"
        "    .cfi_startproc\n"
        "    .cfi_signal_frame\n"
        "    sub sp, sp, #720\n"
        "    .cfi_def_cfa_offset 720\n"
        "    stp x0, x1, [sp, #0]\n"
        "    stp x2, x3, [sp, #16]\n"
        "    stp x4, x5, [sp, #32]\n"
        "    stp x6, x7, [sp, #48]\n"
        "    stp x8, x9, [sp, #64]\n"
        "    stp x10, x11, [sp, #80]\n"
        "    stp x12, x13, [sp, #96]\n"
        "    stp x14, x15, [sp, #112]\n"
        "    stp x16, x17, [sp, #128]\n"
        "    stp x29, x30, [sp, #144]\n"
        "    mrs x0, nzcv\n"
        "    mrs x1, fpcr\n"
        "    mrs x2, fpsr\n"
        "    stp x0, x1, [sp, #160]\n"
        "    str x2, [sp, #176]\n"
        "    stp q0, q1, [sp, #192]\n"
        "    stp q2, q3, [sp, #224]\n"
        "    stp q4, q5, [sp, #256]\n"
        "    stp q6, q7, [sp, #288]\n"
        "    stp q8, q9, [sp, #320]\n"
        "    stp q10, q11, [sp, #352]\n"
        "    stp q12, q13, [sp, #384]\n"
        "    stp q14, q15, [sp, #416]\n"
        "    stp q16, q17, [sp, #448]\n"
        "    stp q18, q19, [sp, #480]\n"
        "    stp q20, q21, [sp, #512]\n"
        "    stp q22, q23, [sp, #544]\n"
        "    stp q24, q25, [sp, #576]\n"
        "    stp q26, q27, [sp, #608]\n"
        "    stp q28, q29, [sp, #640]\n"
        "    stp q30, q31, [sp, #672]\n"
        "    msr fpcr, xzr\n"
        "    bl kern_ap_rip\n"
        "    add x16, sp, #704\n"
        "    stp x29, x0, [x16]\n"
        "    mov x29, x16\n"
        "    .cfi_offset x29, -16\n"
        "    .cfi_offset x30, -8\n"
        "    bl kern_ap_yield\n"
        "    ldr x18, [sp, #712]\n"
        "    ldp q30, q31, [sp, #672]\n"
        "    ldp q28, q29, [sp, #640]\n"
        "    ldp q26, q27, [sp, #608]\n"
        "    ldp q24, q25, [sp, #576]\n"
        "    ldp q22, q23, [sp, #544]\n"
        "    ldp q20, q21, [sp, #512]\n"
        "    ldp q18, q19, [sp, #480]\n"
        "    ldp q16, q17, [sp, #448]\n"
        "    ldp q14, q15, [sp, #416]\n"
        "    ldp q12, q13, [sp, #384]\n"
        "    ldp q10, q11, [sp, #352]\n"
        "    ldp q8, q9, [sp, #320]\n"
        "    ldp q6, q7, [sp, #288]\n"
        "    ldp q4, q5, [sp, #256]\n"
        "    ldp q2, q3, [sp, #224]\n"
        "    ldp q0, q1, [sp, #192]\n"
        "    ldp x0, x1, [sp, #160]\n"
        "    ldr x2, [sp, #176]\n"
        "    msr nzcv, x0\n"
        "    msr fpcr, x1\n"
        "    msr fpsr, x2\n"
        "    ldp x0, x1, [sp, #0]\n"
        "    ldp x2, x3, [sp, #16]\n"
        "    ldp x4, x5, [sp, #32]\n"
        "    ldp x6, x7, [sp, #48]\n"
        "    ldp x8, x9, [sp, #64]\n"
        "    ldp x10, x11, [sp, #80]\n"
        "    ldp x12, x13, [sp, #96]\n"
        "    ldp x14, x15, [sp, #112]\n"
        "    ldp x16, x17, [sp, #128]\n"
        "    ldp x29, x30, [sp, #144]\n"
        "    add sp, sp, #720\n"
        "    br x18\n"
        "    .cfi_endproc\n"
        ".size kern_ap_stub, .-kern_ap_stub\n");
#else
#error "kern_ap_stub.inc: no kern_ap_stub for this architecture"
#endif
